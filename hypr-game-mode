#!/usr/bin/env bash

################################################################################
# Hypr-Game-Mode: TUI Gaming Dashboard for Hyprland
# Modular Bash implementation with proper error handling
################################################################################

set -o pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

if [ -d "${SCRIPT_DIR}/lib" ]; then
    LIB_DIR="${SCRIPT_DIR}/lib"
else
    LIB_DIR="/usr/lib/hypr-game-mode"
fi

load_module() {
    local module="$1"
    local file="${LIB_DIR}/${module}"

    if [ ! -f "$file" ]; then
        printf '❌ Missing module: %s\n' "$file" >&2
        exit 1
    fi

    # shellcheck source=/dev/null
    source "$file"
}

load_module "constants.sh"
load_module "logging.sh"
load_module "utils.sh"
load_module "config.sh"
load_module "game_mode.sh"
load_module "launcher.sh"
load_module "android.sh"
load_module "menus.sh"
load_module "main.sh"

main "$@"
exit $?